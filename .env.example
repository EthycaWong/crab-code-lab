# Copy these entries into .dev.vars for local development.
# npm run lab creates COMPILER_TOKEN and COMPILER_URL automatically.
COMPILER_URL=http://127.0.0.1:4319
COMPILER_TOKEN=replace-with-at-least-24-random-characters
# Optional automatic email delivery. Never commit real credentials.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CRAB Code Lab <your-verified-sender@example.com>
# ARDUINO_CLI=/absolute/path/to/arduino-cli
# Compiler service deployment only:
# COMPILER_HOST=0.0.0.0
# COMPILER_PORT=4319
